{
	"files.associations": {
		"*.css": "tailwindcss",
		"*.html.txt": "html"
	},
	"material-icon-theme.files.associations": {
		"*.html.txt": "html",
	},
	"todohighlight.include": [
		"**/*.js",
		"**/*.jsx",
		"**/*.ts",
		"**/*.tsx",
		"**/*.html",
		"**/*.css",
		"**/*.scss",
		"**/*.php",
		"**/*.rb",
		"**/*.txt",
		"**/*.mdown",
		"**/*.md",
		"**/*.svelte"
	]
}